# Microsoft Foundry project endpoint for Entra-authenticated FoundryChatClient.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project

# Direct Azure OpenAI v1 endpoint. Required for direct model transports and for
# key-authenticated custom Foundry models (the project endpoint uses Entra).
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1

# Optional resource API key for model inference; when absent, use DefaultAzureCredential.
# Keep this secret in your ignored .env or a secret manager; never put it in models.json.
FOUNDRY_API_KEY=

# Optional custom audio-capable deployment exposed in the model picker as "custom-foundry-model".
# For an existing registry entry, edit its "deployment" in config/models.json instead.
BENCHMARK_CUSTOM_MODEL_NAME=

# Managed Voice Live endpoint (not part of the benchmark model runner).
VOICE_LIVE_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
VOICE_LIVE_API_VERSION=2026-04-10

# Keep tracing off by default because audio prompts and transcripts can be sensitive.
BENCHMARK_TRACE_ENABLED=false
BENCHMARK_TRACE_SENSITIVE_DATA=false
BENCHMARK_TRACE_PORT=4317

# Comma-separated origins permitted to use the local API.
BENCHMARK_CORS_ORIGINS=http://localhost:5173

# Optional dataset locations. The base manifest defaults to data/swissdial/manifest.jsonl;
# uploaded ZIP datasets are kept separately under .runtime/datasets by default.
# BENCHMARK_MANIFEST_PATH=C:\path\to\my-dataset\manifest.jsonl
# BENCHMARK_DATASETS_DIR=C:\path\to\my-uploaded-datasets

# Optional text deployment (on AZURE_OPENAI_ENDPOINT) that fuses Realtime hypotheses for the
# "ensemble" strategy. Leave empty to disable that strategy. The effort applies to reasoning models;
# set it to an empty value for non-reasoning deployments.
BENCHMARK_REFINER_DEPLOYMENT=
BENCHMARK_REFINER_REASONING_EFFORT=low