# Microsoft Foundry project endpoint. Credentials are resolved by DefaultAzureCredential.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project

# Direct Azure OpenAI v1 endpoint. This is separate from the Foundry project endpoint
# and is used only by direct Azure OpenAI or Azure AI Evaluation SDK workflows.
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1

# Managed Voice Live endpoint. Authenticate with Microsoft Entra RBAC, never an API key.
VOICE_LIVE_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
VOICE_LIVE_API_VERSION=2026-04-10

# Keep tracing off by default because audio prompts and transcripts can be sensitive.
BENCHMARK_TRACE_ENABLED=false
BENCHMARK_TRACE_SENSITIVE_DATA=false
BENCHMARK_TRACE_PORT=4317

# Comma-separated origins permitted to use the local API.
BENCHMARK_CORS_ORIGINS=http://localhost:5173